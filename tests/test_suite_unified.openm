rule TestCube_Aggregate::Function_Aggregate.FN_COUNTIFS:Case.PassFail = AND(IFERROR(TestCube_Aggregate::Function_Aggregate.FN_COUNTIFS:Case.Happy_1 == 1,FALSE()),IFERROR(TestCube_Aggregate::Function_Aggregate.FN_COUNTIFS:Case.Edge_1 == 0,FALSE()),IFERROR(TestCube_Aggregate::Function_Aggregate.FN_COUNTIFS:Case.Invalid_1,"__OPENM_EXPECTED_ERROR__") == "__OPENM_EXPECTED_ERROR__")
