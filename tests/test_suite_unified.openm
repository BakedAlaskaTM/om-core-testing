# OpenFormula 1.4 section 6.12.30 [Small] Discounts periodic cash flows
rule TestCube_Financial::Function_Financial.FN_NPV:Case.Happy_1 = NPV(0.1,100,100)
# OpenFormula 1.4 section 6.12.30 [Small] Handles a zero discount rate
rule TestCube_Financial::Function_Financial.FN_NPV:Case.Edge_1 = NPV(0,10,20)
# OpenFormula 1.4 section 6.12.30 [Small] Rejects a rate of negative one
rule TestCube_Financial::Function_Financial.FN_NPV:Case.Invalid_1 = NPV(-1,10)
# OpenFormula 1.4 section 6.12.24 [Small] Finds the periodic internal rate of return
rule TestCube_Financial::Function_Financial.FN_IRR:Case.Happy_1 = ROUND(IRR(-100,60,60),6)
# OpenFormula 1.4 section 6.12.24 [Small] Handles a zero-return series
rule TestCube_Financial::Function_Financial.FN_IRR:Case.Edge_1 = IRR(-100,100)
# OpenFormula 1.4 section 6.12.24 [Small] Fails when no sign-changing solution exists
rule TestCube_Financial::Function_Financial.FN_IRR:Case.Invalid_1 = IRR(1,2)
# OpenFormula 1.4 section 6.12.51 [Medium] Finds a dated internal rate of return
rule TestCube_Financial::Function_Financial.FN_XIRR:Case.Happy_1 = ROUND(XIRR(-100,110,DATE(2024,1,1),DATE(2025,1,1)),6)
# OpenFormula 1.4 section 6.12.51 [Medium] Handles a zero dated return
rule TestCube_Financial::Function_Financial.FN_XIRR:Case.Edge_1 = XIRR(-100,100,DATE(2024,1,1),DATE(2025,1,1))
# OpenFormula 1.4 section 6.12.51 [Medium] Fails when no sign-changing solution exists
rule TestCube_Financial::Function_Financial.FN_XIRR:Case.Invalid_1 = XIRR(1,2,DATE(2024,1,1),DATE(2025,1,1))
