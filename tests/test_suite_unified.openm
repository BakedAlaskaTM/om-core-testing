# OpenFormula 1.4 section 6.10.14 [Small] Invalid or error input for MONTH
rule TestCube_Date::Function_Date.FN_MONTH:Case.Invalid_1 = MONTH("x")
# OpenFormula 1.4 section 6.10.24 [Small] Extracts the year from a date
rule TestCube_Date::Function_Date.FN_YEAR:Case.Happy_1 = YEAR(DATE(2024,1,1))
# OpenFormula 1.4 section 6.10.24 [Small] Handles the minimum conforming DATE year
