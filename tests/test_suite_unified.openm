# RULES UNDER TEST
# IEEE 754 2019 section §6.3 [Strict] Negative zero shall be converted to positive zero.
rule TestCube_Math::Function_Math.FN_ABS:Case.TC_MATH_ABS_001 = ABS(-0.0)
# ISO/IEC 10967-2 2001 section §5.2.1 [Core] Finite negative operand returns its magnitude.
rule TestCube_Math::Function_Math.FN_ABS:Case.TC_MATH_ABS_002 = ABS(-42.5)
# ISO/IEC 10967-2 2001 section §5.2.1 [Core] Incoming division error is returned unchanged.
rule TestCube_Math::Function_Math.FN_ABS:Case.TC_MATH_ABS_003 = ABS(1/0)
# ISO/IEC 26300-4 2015 section §6.17.5 [Full] Binary-sensitive decimal midpoint rounds away from zero.
rule TestCube_Math::Function_Math.FN_ROUND:Case.TC_MATH_ROUND_001 = ROUND(2.675,2)
# ISO/IEC 26300-4 2015 section §6.17.5 [Full] Negative midpoint rounds away from zero.
rule TestCube_Math::Function_Math.FN_ROUND:Case.TC_MATH_ROUND_002 = ROUND(-2.5,0)
# ISO/IEC 26300-4 2015 section §6.17.7 [Full] Negative value rounds away from zero.
rule TestCube_Math::Function_Math.FN_ROUNDUP:Case.TC_MATH_ROUNDUP_001 = ROUNDUP(-1.231,2)
# ISO/IEC 26300-4 2015 section §6.17.6 [Full] Negative value rounds toward zero.
rule TestCube_Math::Function_Math.FN_ROUNDDOWN:Case.TC_MATH_ROUNDDOWN_001 = ROUNDDOWN(-1.239,2)
# ISO/IEC 10967-2 2001 section §5.2.2 [Core] Returns binary64 pi.
rule TestCube_Math::Function_Math.FN_PI:Case.TC_MATH_PI_001 = PI()
# ISO/IEC 26300-4 2015 section §6.16.40 [Full] Rejects an argument.
rule TestCube_Math::Function_Math.FN_PI:Case.TC_MATH_PI_002 = PI(1)
# ISO/IEC 10967-2 2001 section §5.2.3 [Core] Natural logarithm identity.
rule TestCube_Math::Function_Math.FN_LN:Case.TC_MATH_LN_001 = LN(1)
# ISO/IEC 10967-2 2001 section §5.2.3 [Core] Zero is outside the logarithm domain.
rule TestCube_Math::Function_Math.FN_LN:Case.TC_MATH_LN_002 = LN(0)
# ISO/IEC 10967-2 2001 section §5.2.3 [Core] Integer logarithm in base two.
rule TestCube_Math::Function_Math.FN_LOG:Case.TC_MATH_LOG_001 = LOG(8,2)
# ISO/IEC 10967-2 2001 section §5.2.3 [Core] Base one is invalid.
rule TestCube_Math::Function_Math.FN_LOG:Case.TC_MATH_LOG_002 = LOG(10,1)
# ISO/IEC 10967-2 2001 section §5.2.3 [Core] Common logarithm at a power of ten.
rule TestCube_Math::Function_Math.FN_LOG10:Case.TC_MATH_LOG10_001 = LOG10(1000)
# ISO/IEC 10967-2 2001 section §5.2.3 [Core] Negative operand is outside the real domain.
rule TestCube_Math::Function_Math.FN_LOG10:Case.TC_MATH_LOG10_002 = LOG10(-5)
# ISO/IEC 10967-2 2001 section §5.2.4 [Core] Exponential identity.
rule TestCube_Math::Function_Math.FN_EXP:Case.TC_MATH_EXP_001 = EXP(0)
# IEEE 754 2019 section §9.2.1 [Strict] Binary64 overflow is a numeric error.
rule TestCube_Math::Function_Math.FN_EXP:Case.TC_MATH_EXP_002 = EXP(1000)
# ISO/IEC 10967-2 2001 section §5.2.5 [Core] Perfect square.
rule TestCube_Math::Function_Math.FN_SQRT:Case.TC_MATH_SQRT_001 = SQRT(4)
# ISO/IEC 10967-2 2001 section §5.2.5 [Core] Negative operand is outside the real domain.
rule TestCube_Math::Function_Math.FN_SQRT:Case.TC_MATH_SQRT_002 = SQRT(-1)
# IEEE 754 2019 section §9.2.1 [Strict] Typed incoming CellError argument is returned immediately.
rule TestCube_Math::Function_Math.FN_SQRT:Case.TC_MATH_SQRT_003 = SQRT("#DIV/0!")
# IEEE 754 2019 section §9.2.1 [Strict] Nested error short-circuits domain logic.
rule TestCube_Math::Function_Math.FN_SQRT:Case.TC_MATH_SQRT_004 = SQRT(1/0)
# ISO/IEC 10967-2 2001 section §5.2.6 [Core] Exact integer power.
rule TestCube_Math::Function_Math.FN_POWER:Case.TC_MATH_POWER_001 = POWER(2,10)
# ISO/IEC 10967-2 2001 section §5.2.6 [Core] Zero to a negative power divides by zero.
rule TestCube_Math::Function_Math.FN_POWER:Case.TC_MATH_POWER_002 = POWER(0,-1)
# ISO/IEC 26300-4 2015 section §6.17.9 [Full] Negative classification.
rule TestCube_Math::Function_Math.FN_SIGN:Case.TC_MATH_SIGN_001 = SIGN(-7)
# IEEE 754 2019 section §6.3 [Strict] Signed zero classifies as zero.
rule TestCube_Math::Function_Math.FN_SIGN:Case.TC_MATH_SIGN_002 = SIGN(-0.0)
# ISO/IEC 26300-4 2015 section §6.17.2 [Full] OM Core truncates toward zero.
rule TestCube_Math::Function_Math.FN_INT:Case.TC_MATH_INT_001 = INT(-3.9)
# ISO/IEC 26300-4 2015 section §6.17.3 [Full] Remainder takes the positive divisor sign.
rule TestCube_Math::Function_Math.FN_MOD:Case.TC_MATH_MOD_001 = MOD(-10,3)
# ISO/IEC 26300-4 2015 section §6.17.3 [Full] Remainder takes the negative divisor sign.
rule TestCube_Math::Function_Math.FN_MOD:Case.TC_MATH_MOD_002 = MOD(10,-3)
# ISO/IEC 26300-4 2015 section §6.17.3 [Full] Zero divisor.
rule TestCube_Math::Function_Math.FN_MOD:Case.TC_MATH_MOD_003 = MOD(10,0)
# ISO/IEC 26300-4 2015 section §6.17.4 [Full] Quotient truncates toward zero.
rule TestCube_Math::Function_Math.FN_QUOTIENT:Case.TC_MATH_QUOTIENT_001 = QUOTIENT(-10,3)
# ISO/IEC 26300-4 2015 section §6.17.1 [Full] Round down to a significance multiple.
rule TestCube_Math::Function_Math.FN_FLOOR:Case.TC_MATH_FLOOR_001 = FLOOR(7.8,2)
# ISO/IEC 26300-4 2015 section §6.17.1 [Full] Zero significance.
rule TestCube_Math::Function_Math.FN_FLOOR:Case.TC_MATH_FLOOR_002 = FLOOR(5,0)
# ISO/IEC 26300-4 2015 section §6.17.10 [Full] Round toward positive infinity.
rule TestCube_Math::Function_Math.FN_CEILING:Case.TC_MATH_CEILING_001 = CEILING(-7.1,2)
# ISO/IEC 26300-4 2015 section §6.17.11 [Full] Truncate at two decimals toward zero.
rule TestCube_Math::Function_Math.FN_TRUNC:Case.TC_MATH_TRUNC_001 = TRUNC(-12.345,2)
# ISO/IEC 10967-2 2001 section §5.3.1 [Core] Sine at pi over two.
rule TestCube_Trigonometric::Function_Trigonometric.FN_SIN:Case.TC_TRIG_SIN_001 = SIN(PI()/2)
# ISO/IEC 10967-2 2001 section §5.3.2 [Core] Cosine at pi.
rule TestCube_Trigonometric::Function_Trigonometric.FN_COS:Case.TC_TRIG_COS_001 = COS(PI())
# ISO/IEC 10967-2 2001 section §5.3.3 [Core] Tangent at pi over four.
rule TestCube_Trigonometric::Function_Trigonometric.FN_TAN:Case.TC_TRIG_TAN_001 = TAN(PI()/4)
# ISO/IEC 10967-2 2001 section §5.3.4 [Core] Upper domain endpoint.
rule TestCube_Trigonometric::Function_Trigonometric.FN_ASIN:Case.TC_TRIG_ASIN_001 = ASIN(1)
# ISO/IEC 10967-2 2001 section §5.3.4 [Core] Operand above one.
rule TestCube_Trigonometric::Function_Trigonometric.FN_ASIN:Case.TC_TRIG_ASIN_002 = ASIN(1.0000001)
# ISO/IEC 10967-2 2001 section §5.3.5 [Core] Upper domain endpoint.
rule TestCube_Trigonometric::Function_Trigonometric.FN_ACOS:Case.TC_TRIG_ACOS_001 = ACOS(1)
# ISO/IEC 10967-2 2001 section §5.3.5 [Core] Operand below minus one.
rule TestCube_Trigonometric::Function_Trigonometric.FN_ACOS:Case.TC_TRIG_ACOS_002 = ACOS(-1.0000001)
# ISO/IEC 10967-2 2001 section §5.3.6 [Core] Arctangent at one.
rule TestCube_Trigonometric::Function_Trigonometric.FN_ATAN:Case.TC_TRIG_ATAN_001 = ATAN(1)
# IEEE 754 2019 section §9.2.1 [Strict] Positive zero ordinate selects positive pi.
rule TestCube_Trigonometric::Function_Trigonometric.FN_ATAN2:Case.TC_TRIG_ATAN2_001 = ATAN2(+0.0,-1.0)
# IEEE 754 2019 section §9.2.1 [Strict] Negative zero ordinate selects negative pi.
rule TestCube_Trigonometric::Function_Trigonometric.FN_ATAN2:Case.TC_TRIG_ATAN2_002 = ATAN2(-0.0,-1.0)
# ISO/IEC 26300-4 2015 section §6.16.44 [Full] Degrees to radians.
rule TestCube_Trigonometric::Function_Trigonometric.FN_RADIANS:Case.TC_TRIG_RADIANS_001 = RADIANS(180)
# ISO/IEC 26300-4 2015 section §6.16.18 [Full] Radians to degrees.
rule TestCube_Trigonometric::Function_Trigonometric.FN_DEGREES:Case.TC_TRIG_DEGREES_001 = DEGREES(PI())
# ISO/IEC 26300-4 2015 section §6.10.2 [Full] OpenFormula epoch evaluates to serial zero.
rule TestCube_Date::Function_Date.FN_DATE:Case.TC_DATE_DATE_001 = DATE(1899,12,30)
# ISO/IEC 26300-4 2015 section §6.10.2 [Strict] Gregorian 1900 is not a leap year.
rule TestCube_Date::Function_Date.FN_DATE:Case.TC_DATE_DATE_002 = DATE(1900,2,29)
# ISO/IEC 26300-4 2015 section §6.10.2 [Full] Century divisible by 400 accepts leap day.
rule TestCube_Date::Function_Date.FN_DATE:Case.TC_DATE_DATE_003 = DATE(2000,2,29)
# ISO/IEC 26300-4 2015 section §6.10.5 [Full] Epoch day of month.
rule TestCube_Date::Function_Date.FN_DAY:Case.TC_DATE_DAY_001 = DAY(0)
# ISO/IEC 26300-4 2015 section §6.10.14 [Full] Epoch month.
rule TestCube_Date::Function_Date.FN_MONTH:Case.TC_DATE_MONTH_001 = MONTH(0)
# ISO/IEC 26300-4 2015 section §6.10.24 [Full] Epoch year.
rule TestCube_Date::Function_Date.FN_YEAR:Case.TC_DATE_YEAR_001 = YEAR(0)
# ISO/IEC 26300-4 2015 section §6.10.10 [Full] Leap-year February end.
rule TestCube_Date::Function_Date.FN_EOMONTH:Case.TC_DATE_EOMONTH_001 = DAY(EOMONTH(DATE(2024,2,1),0))
# ISO/IEC 26300-4 2015 section §6.10.21 [Full] Monday-first numbering.
rule TestCube_Date::Function_Date.FN_WEEKDAY:Case.TC_DATE_WEEKDAY_001 = WEEKDAY(DATE(2024,1,1),2)
# ISO/IEC 26300-4 2015 section §6.10.21 [Full] Unsupported return type.
rule TestCube_Date::Function_Date.FN_WEEKDAY:Case.TC_DATE_WEEKDAY_002 = WEEKDAY(DATE(2024,1,1),99)
# ISO/IEC 26300-4 2015 section §6.10.22 [Full] ISO week one boundary.
rule TestCube_Date::Function_Date.FN_WEEKNUM:Case.TC_DATE_WEEKNUM_001 = WEEKNUM(DATE(2021,1,4),21)
# ISO/IEC 26300-4 2015 section §6.10.22 [Full] Unsupported week mode.
rule TestCube_Date::Function_Date.FN_WEEKNUM:Case.TC_DATE_WEEKNUM_002 = WEEKNUM(DATE(2024,1,1),99)
# ISO/IEC 26300-4 2015 section §6.10.19 [Full] Repeated calls use the same day.
rule TestCube_Date::Function_Date.FN_TODAY:Case.TC_DATE_TODAY_001 = TODAY()-TODAY()
# ISO/IEC 26300-4 2015 section §6.10.15 [Full] Repeated calls are stable within tolerance.
rule TestCube_Date::Function_Date.FN_NOW:Case.TC_DATE_NOW_001 = NOW()-NOW()
# ISO/IEC 26300-4 2015 section §6.16.61 [Full] Mixed-sign aggregation.
rule TestCube_Aggregate::Function_Aggregate.FN_SUM:Case.TC_AGG_SUM_001 = SUM(10,-4,2.5)
# ISO/IEC 26300-4 2015 section §6.16.61 [Full] Propagates incoming error.
rule TestCube_Aggregate::Function_Aggregate.FN_SUM:Case.TC_AGG_SUM_002 = SUM(1/0)
# ISO/IEC 26300-4 2015 section §6.18.48 [Full] Least signed value.
rule TestCube_Aggregate::Function_Aggregate.FN_MIN:Case.TC_AGG_MIN_001 = MIN(0,-5,9)
# ISO/IEC 26300-4 2015 section §6.18.44 [Full] Greatest signed value.
rule TestCube_Aggregate::Function_Aggregate.FN_MAX:Case.TC_AGG_MAX_001 = MAX(0,-5,9)
# ISO/IEC 26300-4 2015 section §6.18.3 [Full] Arithmetic mean.
rule TestCube_Aggregate::Function_Aggregate.FN_AVERAGE:Case.TC_AGG_AVERAGE_001 = AVERAGE(2,4,6)
# ISO/IEC 26300-4 2015 section §6.18.3 [Full] Empty mean.
rule TestCube_Aggregate::Function_Aggregate.FN_AVERAGE:Case.TC_AGG_AVERAGE_002 = AVERAGE()
# ISO/IEC 26300-4 2015 section §6.18.3 [Full] OM Core mean alias.
rule TestCube_Aggregate::Function_Aggregate.FN_AVG:Case.TC_AGG_AVG_001 = AVG(1,2,6)
# ISO/IEC 26300-4 2015 section §6.18.8 [Full] Counts numeric operands only.
rule TestCube_Aggregate::Function_Aggregate.FN_COUNT:Case.TC_AGG_COUNT_001 = COUNT(1,"x",2)
# ISO/IEC 26300-4 2015 section §6.18.9 [Full] Counts nonblank operands.
rule TestCube_Aggregate::Function_Aggregate.FN_COUNTA:Case.TC_AGG_COUNTA_001 = COUNTA(1,"x",0)
# ISO/IEC 26300-4 2015 section §6.18.10 [Full] Scalar criterion match.
rule TestCube_Aggregate::Function_Aggregate.FN_COUNTIF:Case.TC_AGG_COUNTIF_001 = COUNTIF(5,">3")
# ISO/IEC 26300-4 2015 section §6.18.11 [Full] All criteria match.
rule TestCube_Aggregate::Function_Aggregate.FN_COUNTIFS:Case.TC_AGG_COUNTIFS_001 = COUNTIFS(5,">3",5,"<10")
# ISO/IEC 26300-4 2015 section §6.18.63 [Full] Matching criterion contributes value.
rule TestCube_Aggregate::Function_Aggregate.FN_SUMIF:Case.TC_AGG_SUMIF_001 = SUMIF(5,">3",7)
# ISO/IEC 26300-4 2015 section §6.18.64 [Full] All criteria include sum value.
rule TestCube_Aggregate::Function_Aggregate.FN_SUMIFS:Case.TC_AGG_SUMIFS_001 = SUMIFS(7,5,">3",8,"<10")
# ISO/IEC 26300-4 2015 section §6.15.4 [Full] True branch.
rule TestCube_Logical::Function_Logical.FN_IF:Case.TC_LOGIC_IF_001 = IF(TRUE(),"yes","no")
# ISO/IEC 26300-4 2015 section §6.15.4 [Strict] Unselected error branch is not evaluated.
rule TestCube_Logical::Function_Logical.FN_IF:Case.TC_LOGIC_IF_002 = IF(TRUE(),42,1/0)
# ISO/IEC 26300-4 2015 section §6.15.2 [Full] One false operand returns the numeric logical value 0.0.
rule TestCube_Logical::Function_Logical.FN_AND:Case.TC_LOGIC_AND_001 = AND(TRUE(),FALSE())
# ISO/IEC 26300-4 2015 section §6.15.8 [Full] One true operand returns the numeric logical value 1.0.
rule TestCube_Logical::Function_Logical.FN_OR:Case.TC_LOGIC_OR_001 = OR(FALSE(),TRUE())
# ISO/IEC 26300-4 2015 section §6.15.7 [Full] Negating true returns the numeric logical value 0.0.
rule TestCube_Logical::Function_Logical.FN_NOT:Case.TC_LOGIC_NOT_001 = NOT(TRUE())
# ISO/IEC 26300-4 2015 section §6.15.7 [Full] Propagates incoming error.
rule TestCube_Logical::Function_Logical.FN_NOT:Case.TC_LOGIC_NOT_002 = NOT(1/0)
# ISO/IEC 26300-4 2015 section §6.15.10 [Full] Odd true parity returns the numeric logical value 1.0.
rule TestCube_Logical::Function_Logical.FN_XOR:Case.TC_LOGIC_XOR_001 = XOR(TRUE(),FALSE())
# ISO/IEC 26300-4 2015 section §6.15.9 [Full] TRUE returns the numeric logical value 1.0.
rule TestCube_Logical::Function_Logical.FN_TRUE:Case.TC_LOGIC_TRUE_001 = TRUE()
# ISO/IEC 26300-4 2015 section §6.15.3 [Full] FALSE returns the numeric logical value 0.0.
rule TestCube_Logical::Function_Logical.FN_FALSE:Case.TC_LOGIC_FALSE_001 = FALSE()
# ISO/IEC 26300-4 2015 section §6.15.5 [Full] Fallback for typed error.
rule TestCube_Logical::Function_Logical.FN_IFERROR:Case.TC_LOGIC_IFERROR_001 = IFERROR(1/0,99)
# ISO/IEC 26300-4 2015 section §6.15.5 [Strict] Unused fallback error is short-circuited.
rule TestCube_Logical::Function_Logical.FN_IFERROR:Case.TC_LOGIC_IFERROR_002 = IFERROR(7,1/0)
# ISO/IEC 10646 2020 section §2.2 [Full] Counts Unicode scalar characters.
rule TestCube_String::Function_String.FN_LEN:Case.TC_STRING_LEN_001 = LEN("A😀B")
# ISO/IEC 26300-4 2015 section §6.20.31 [Full] Removes boundary spaces.
rule TestCube_String::Function_String.FN_TRIM:Case.TC_STRING_TRIM_001 = TRIM("  alpha  ")
# ISO/IEC 26300-4 2015 section §6.20.12 [Full] Requested prefix.
rule TestCube_String::Function_String.FN_LEFT:Case.TC_STRING_LEFT_001 = LEFT("OpenM",4)
# ISO/IEC 26300-4 2015 section §6.20.24 [Full] Requested suffix.
rule TestCube_String::Function_String.FN_RIGHT:Case.TC_STRING_RIGHT_001 = RIGHT("OpenM",2)
# ISO/IEC 26300-4 2015 section §6.20.23 [Full] Repeated text.
rule TestCube_String::Function_String.FN_REPT:Case.TC_STRING_REPT_001 = REPT("ab",3)
# ISO/IEC 26300-4 2015 section §6.20.23 [Full] Negative count.
rule TestCube_String::Function_String.FN_REPT:Case.TC_STRING_REPT_002 = REPT("x",-1)
# ISO/IEC 10646 2020 section §2.2 [Full] Basic Latin code point.
rule TestCube_String::Function_String.FN_CODE:Case.TC_STRING_CODE_001 = CODE("A")
# ISO/IEC 10646 2020 section §2.2 [Full] Empty string has no first character.
rule TestCube_String::Function_String.FN_CODE:Case.TC_STRING_CODE_002 = CODE("")
# ISO/IEC 10646 2020 section §2.2 [Full] Code 65 maps to A.
rule TestCube_String::Function_String.FN_CHAR:Case.TC_STRING_CHAR_001 = CHAR(65)
# ISO/IEC 10646 2020 section §2.2 [Full] Zero code is unsupported.
rule TestCube_String::Function_String.FN_CHAR:Case.TC_STRING_CHAR_002 = CHAR(0)
# ISO/IEC 26300-4 2015 section §6.20.8 [Full] Text and number concatenation.
rule TestCube_String::Function_String.FN_CONCAT:Case.TC_STRING_CONCAT_001 = CONCAT("Open","M",2026)
# ISO/IEC 26300-4 2015 section §6.20.8 [Full] Legacy alias concatenation.
rule TestCube_String::Function_String.FN_CONCATENATE:Case.TC_STRING_CONCATENATE_001 = CONCATENATE("a","b","c")
# ISO/IEC 26300-4 2015 section §6.20.10 [Full] One-based case-sensitive index.
rule TestCube_String::Function_String.FN_FIND:Case.TC_STRING_FIND_001 = FIND("M","OpenM")
# ISO/IEC 26300-4 2015 section §6.20.10 [Full] Case mismatch.
rule TestCube_String::Function_String.FN_FIND:Case.TC_STRING_FIND_002 = FIND("m","OpenM")
# ISO/IEC 26300-4 2015 section §6.20.17 [Full] Interior substring.
rule TestCube_String::Function_String.FN_MID:Case.TC_STRING_MID_001 = MID("abcdef",2,3)
# ISO/IEC 26300-4 2015 section §6.20.17 [Full] Start below one.
rule TestCube_String::Function_String.FN_MID:Case.TC_STRING_MID_002 = MID("abc",0,1)
# ISO/IEC 10646 2020 section §3.13 [Full] Unicode uppercase expansion.
rule TestCube_String::Function_String.FN_UPPER:Case.TC_STRING_UPPER_001 = UPPER("Straße")
# ISO/IEC 10646 2020 section §3.13 [Full] Unicode lowercase mapping.
rule TestCube_String::Function_String.FN_LOWER:Case.TC_STRING_LOWER_001 = LOWER("ÉLAN")
# ISO/IEC 10646 2020 section §3.13 [Full] Word title casing.
rule TestCube_String::Function_String.FN_PROPER:Case.TC_STRING_PROPER_001 = PROPER("open model")
# ISO/IEC 26300-4 2015 section §6.20.27 [Full] Selected occurrence replacement.
rule TestCube_String::Function_String.FN_SUBSTITUTE:Case.TC_STRING_SUBSTITUTE_001 = SUBSTITUTE("a-b-a","a","x",2)
# ISO/IEC 26300-4 2015 section §6.20.22 [Full] One-based span replacement.
rule TestCube_String::Function_String.FN_REPLACE:Case.TC_STRING_REPLACE_001 = REPLACE("abcdef",2,3,"X")
# ISO/IEC 26300-4 2015 section §6.13.34 [Full] Decimal text conversion.
rule TestCube_String::Function_String.FN_VALUE:Case.TC_STRING_VALUE_001 = VALUE("12.5")
# ISO/IEC 26300-4 2015 section §6.13.34 [Full] Nonnumeric text.
rule TestCube_String::Function_String.FN_VALUE:Case.TC_STRING_VALUE_002 = VALUE("abc")
# OM Core 2026 section §Metadata.LABEL [Full] Fixture current coordinate Org.North returns its label.
rule TestCube_Hierarchy::Function_Hierarchy.FN_LABEL:Case.TC_HIER_LABEL_001 = LABEL(Org)
# OM Core 2026 section §Metadata.POS [Full] Fixture Org.North has one-based position two.
rule TestCube_Hierarchy::Function_Hierarchy.FN_POS:Case.TC_HIER_POS_001 = POS(Org)
# OM Core 2026 section §Metadata.POSMAX [Full] Fixture Org contains three items.
rule TestCube_Hierarchy::Function_Hierarchy.FN_POSMAX:Case.TC_HIER_POSMAX_001 = POSMAX(Org)
# OM Core 2026 section §Hierarchy.ANCE [Full] Fixture leaf returns ancestor Total.
rule TestCube_Hierarchy::Function_Hierarchy.FN_ANCE:Case.TC_HIER_ANCE_001 = JOIN(ANCE(Org.North),",")
# OM Core 2026 section §Hierarchy.PEER [Full] Fixture returns same-level peers.
rule TestCube_Hierarchy::Function_Hierarchy.FN_PEER:Case.TC_HIER_PEER_001 = JOIN(PEER(Org.North),",")
# OM Core 2026 section §Hierarchy.SIBL [Full] Fixture returns sibling.
rule TestCube_Hierarchy::Function_Hierarchy.FN_SIBL:Case.TC_HIER_SIBL_001 = JOIN(SIBL(Org.North),",")
# OM Core 2026 section §Hierarchy.DESC [Full] Fixture parent returns descendant leaves.
rule TestCube_Hierarchy::Function_Hierarchy.FN_DESC:Case.TC_HIER_DESC_001 = JOIN(DESC(Org.Total),",")
# OM Core 2026 section §Hierarchy.CHIL [Full] Fixture parent returns immediate children.
rule TestCube_Hierarchy::Function_Hierarchy.FN_CHIL:Case.TC_HIER_CHIL_001 = JOIN(CHIL(Org.Total),",")
# OM Core 2026 section §Hierarchy.PARE [Full] Fixture leaf returns parent.
rule TestCube_Hierarchy::Function_Hierarchy.FN_PARE:Case.TC_HIER_PARE_001 = JOIN(PARE(Org.North),",")
# OM Core 2026 section §Array.JOIN [Full] Joins list with delimiter.
rule TestCube_Hierarchy::Function_Hierarchy.FN_JOIN:Case.TC_HIER_JOIN_001 = JOIN(CHIL(Org.Total),"|")
# OM Core 2026 section §Array.SLICE [Full] Fixture slice resolves North value.
rule TestCube_Hierarchy::Function_Hierarchy.FN_SLICE:Case.TC_HIER_SLICE_001 = SUM(SLICE(Org.North))
# OM Core 2026 section §Array.REF [Full] Fixture reference exposes coordinate.
rule TestCube_Hierarchy::Function_Hierarchy.FN_REF:Case.TC_HIER_REF_001 = JOIN(REF(Org.North),",")
# IEC 61966-2-1 1999 section §4.2 [Full] Channel endpoints encode as uppercase sRGB hex.
rule TestCube_Color::Function_Color.FN_RGB:Case.TC_COLOR_RGB_001 = RGB(255,0,128)
# IEC 61966-2-1 1999 section §4.2 [Full] Channels clamp and truncate fractions.
rule TestCube_Color::Function_Color.FN_RGB:Case.TC_COLOR_RGB_002 = RGB(-1,300,12.9)
# IEC 61966-2-1 1999 section §4.2 [Full] Propagates incoming error.
rule TestCube_Color::Function_Color.FN_RGB:Case.TC_COLOR_RGB_003 = RGB(1/0,0,0)
# IEC 61966-2-1 1999 section §4.2 [Full] Full-saturation red.
rule TestCube_Color::Function_Color.FN_HSV2RGB:Case.TC_COLOR_HSV2RGB_001 = HSV2RGB(0,100,100)
# IEC 61966-2-1 1999 section §4.2 [Full] Full-saturation green.
rule TestCube_Color::Function_Color.FN_HSV2RGB:Case.TC_COLOR_HSV2RGB_002 = HSV2RGB(120,100,100)
# IEC 61966-2-1 1999 section §4.2 [Full] Hue wraps modulo 360.
rule TestCube_Color::Function_Color.FN_HSV2RGB:Case.TC_COLOR_HSV2RGB_003 = HSV2RGB(360,100,100)
# IEC 61966-2-1 1999 section §4.2 [Full] Viridis lower endpoint.
rule TestCube_Color::Function_Color.FN_COLORMAP:Case.TC_COLOR_COLORMAP_001 = COLORMAP("viridis",0)
# IEC 61966-2-1 1999 section §4.2 [Full] Grayscale upper endpoint.
rule TestCube_Color::Function_Color.FN_COLORMAP:Case.TC_COLOR_COLORMAP_002 = COLORMAP("grayscale",1)
# IEC 61966-2-1 1999 section §4.2 [Full] Unknown palette.
rule TestCube_Color::Function_Color.FN_COLORMAP:Case.TC_COLOR_COLORMAP_003 = COLORMAP("unknown",0.5)
# ISO/IEC 26300-2 2015 section §6.14.6 [Full] Returns the second column from the fixture row.
rule TestCube_Lookup::Function_Lookup.FN_INDEX:Case.TC_LOOKUP_INDEX_001 = INDEX(MockCube::Row.Data1:Column.C1..C3,1,2)
# ISO/IEC 26300-2 2015 section §6.14.6 [Full] Column index beyond the reference is rejected.
rule TestCube_Lookup::Function_Lookup.FN_INDEX:Case.TC_LOOKUP_INDEX_002 = INDEX(MockCube::Row.Data1:Column.C1..C3,1,4)
# ISO/IEC 26300-2 2015 section §6.14.11 [Full] Offsets one column to the right.
rule TestCube_Lookup::Function_Lookup.FN_OFFSET:Case.TC_LOOKUP_OFFSET_001 = OFFSET(MockCube::Row.Data1:Column.C1,0,1)
# ISO/IEC 26300-2 2015 section §6.14.11 [Full] Offsets one row upward to the header.
rule TestCube_Lookup::Function_Lookup.FN_OFFSET:Case.TC_LOOKUP_OFFSET_002 = OFFSET(MockCube::Row.Data1:Column.C1,-1,0)
# ISO/IEC 26300-2 2015 section §6.14.9 [Full] Exact match returns a one-based position.
rule TestCube_Lookup::Function_Lookup.FN_MATCH:Case.TC_LOOKUP_MATCH_001 = MATCH(20,MockCube::Row.Data1:Column.C1..C3,0)
# ISO/IEC 26300-2 2015 section §6.14.9 [Full] Missing exact value returns not-available.
rule TestCube_Lookup::Function_Lookup.FN_MATCH:Case.TC_LOOKUP_MATCH_002 = MATCH(999,MockCube::Row.Data1:Column.C1..C3,0)
# ISO/IEC 26300-2 2015 section §6.14.8 [Full] Finds an exact value in an ordered vector.
rule TestCube_Lookup::Function_Lookup.FN_LOOKUP:Case.TC_LOOKUP_LOOKUP_001 = LOOKUP(20,MockCube::Row.Data1:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.14.8 [Full] Value below the ordered vector minimum is unavailable.
rule TestCube_Lookup::Function_Lookup.FN_LOOKUP:Case.TC_LOOKUP_LOOKUP_002 = LOOKUP(5,MockCube::Row.Data1:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.12.30 [Full] DCF discounts end-of-period cash flows at ten percent.
rule TestCube_Financial::Function_Financial.FN_NPV:Case.TC_FIN_NPV_001 = NPV(0.1,100,100)
# ISO/IEC 26300-2 2015 section §6.12.30 [Strict] Zero discount rate preserves nominal cash flows.
rule TestCube_Financial::Function_Financial.FN_NPV:Case.TC_FIN_NPV_002 = NPV(0,10,20)
# ISO/IEC 26300-2 2015 section §6.12.30 [Strict] DCF rate at minus one makes the discount denominator invalid.
rule TestCube_Financial::Function_Financial.FN_NPV:Case.TC_FIN_NPV_003 = NPV(-1,10)
# ISO/IEC 26300-2 2015 section §6.12.24 [Full] Newton-Raphson solves periodic cash flows to the zero-NPV rate.
rule TestCube_Financial::Function_Financial.FN_IRR:Case.TC_FIN_IRR_001 = IRR(MockCube::Row.Periodic:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.12.24 [Strict] Alternate admissible guess converges to the same economic root.
rule TestCube_Financial::Function_Financial.FN_IRR:Case.TC_FIN_IRR_002 = IRR(MockCube::Row.Periodic:Column.C1..C3,0.5)
# ISO/IEC 26300-2 2015 section §6.12.24 [Strict] Cash flows without a sign change have no internal rate root.
rule TestCube_Financial::Function_Financial.FN_IRR:Case.TC_FIN_IRR_003 = IRR(MockCube::Row.Data1:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.12.51 [Full] Newton-Raphson uses Actual/365 day-count fractions across leap year 2024.
rule TestCube_Financial::Function_Financial.FN_XIRR:Case.TC_FIN_XIRR_001 = XIRR(MockCube::Row.Dated:Column.C1..C3,MockCube::Row.Dates:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.12.51 [Strict] Alternate guess converges to the same dated-cash-flow root.
rule TestCube_Financial::Function_Financial.FN_XIRR:Case.TC_FIN_XIRR_002 = XIRR(MockCube::Row.Dated:Column.C1..C3,MockCube::Row.Dates:Column.C1..C3,0.5)
# ISO/IEC 26300-2 2015 section §6.12.51 [Strict] Dated cash flows without a sign change have no root.
rule TestCube_Financial::Function_Financial.FN_XIRR:Case.TC_FIN_XIRR_003 = XIRR(MockCube::Row.Data1:Column.C1..C3,MockCube::Row.Dates:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.16.50 [Full] Random value remains in the half-open unit interval.
rule TestCube_Volatile::Function_Volatile.FN_RAND:Case.TC_VOL_RAND_001 = AND(RAND()>=0,RAND()<1)
# ISO/IEC 26300-2 2015 section §6.16.51 [Full] Equal inclusive bounds return that bound deterministically.
rule TestCube_Volatile::Function_Volatile.FN_RANDBETWEEN:Case.TC_VOL_RANDBETWEEN_001 = RANDBETWEEN(5,5)
# ISO/IEC 26300-2 2015 section §6.16.51 [Full] Reversed bounds are invalid.
rule TestCube_Volatile::Function_Volatile.FN_RANDBETWEEN:Case.TC_VOL_RANDBETWEEN_002 = RANDBETWEEN(2,1)
# ISO/IEC 26300-2 2015 section §6.16.2 [Full] OpenFormula compatibility absolute value.
rule TestCube_Math::Function_Math.FN_XLS_ABS:Case.TC_MATH_XLS_ABS_001 = XLS_ABS(-42.5)
# ISO/IEC 26300-2 2015 section §6.17.5 [Strict] OpenFormula midpoint rounds away from zero.
rule TestCube_Math::Function_Math.FN_XLS_ROUND:Case.TC_MATH_XLS_ROUND_001 = XLS_ROUND(2.5,0)
# ISO/IEC 26300-2 2015 section §6.20.3 [Full] OpenFormula character code 65 maps to A.
rule TestCube_String::Function_String.FN_XLS_CHAR:Case.TC_STRING_XLS_CHAR_001 = XLS_CHAR(65)
# ISO/IEC 26300-2 2015 section §6.20.5 [Full] OpenFormula returns the first character code.
rule TestCube_String::Function_String.FN_XLS_CODE:Case.TC_STRING_XLS_CODE_001 = XLS_CODE("A")
# ISO/IEC 26300-2 2015 section §6.14.3 [Full] One-based index selects the second alternative.
rule TestCube_Lookup::Function_Lookup.FN_XLS_CHOOSE:Case.TC_LOOKUP_XLS_CHOOSE_001 = XLS_CHOOSE(2,"red","green","blue")
# ISO/IEC 26300-2 2015 section §6.14.3 [Strict] Index below one is invalid.
rule TestCube_Lookup::Function_Lookup.FN_XLS_CHOOSE:Case.TC_LOOKUP_XLS_CHOOSE_002 = XLS_CHOOSE(0,"a","b")
# ISO/IEC 26300-2 2015 section §6.13.5 [Full] Returns the fixture reference column count.
rule TestCube_Lookup::Function_Lookup.FN_XLS_COLUMNS:Case.TC_LOOKUP_XLS_COLUMNS_001 = XLS_COLUMNS(MockCube::Row.Data1:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.20.6 [Full] Concatenates OpenFormula text operands.
rule TestCube_String::Function_String.FN_XLS_CONCATENATE:Case.TC_STRING_XLS_CONCATENATE_001 = XLS_CONCATENATE("Open","Formula")
# ISO/IEC 26300-2 2015 section §6.13.6 [Full] Counts three numeric scalar arguments.
rule TestCube_Aggregate::Function_Aggregate.FN_XLS_COUNT:Case.TC_AGG_XLS_COUNT_001 = XLS_COUNT(1,2,3)
# ISO/IEC 26300-2 2015 section §6.10.2 [Full] OpenFormula epoch maps to serial zero.
rule TestCube_Date::Function_Date.FN_XLS_DATE:Case.TC_DATE_XLS_DATE_001 = XLS_DATE(1899,12,30)
# ISO/IEC 26300-2 2015 section §6.10.2 [Strict] Gregorian 1900 leap-day invalidity is preserved.
rule TestCube_Date::Function_Date.FN_XLS_DATE:Case.TC_DATE_XLS_DATE_002 = XLS_DATE(1900,2,29)
# ISO/IEC 26300-2 2015 section §6.10.9 [Full] OpenFormula end-of-month handles a leap year.
rule TestCube_Date::Function_Date.FN_XLS_EOMONTH:Case.TC_DATE_XLS_EOMONTH_001 = DAY(XLS_EOMONTH(XLS_DATE(2024,2,1),0))
# ISO/IEC 26300-2 2015 section §6.15.3 [Full] OpenFormula false is stored as numeric zero.
rule TestCube_Logical::Function_Logical.FN_XLS_FALSE:Case.TC_LOGIC_XLS_FALSE_001 = XLS_FALSE()
# ISO/IEC 26300-2 2015 section §6.14.5 [Full] Exact horizontal lookup returns the second-row value.
rule TestCube_Lookup::Function_Lookup.FN_XLS_HLOOKUP:Case.TC_LOOKUP_XLS_HLOOKUP_001 = XLS_HLOOKUP(2,MockCube::Row.Header..Data1:Column.C1..C3,2,FALSE())
# ISO/IEC 26300-2 2015 section §6.15.4 [Strict] OpenFormula IF does not evaluate the unselected error branch.
rule TestCube_Logical::Function_Logical.FN_XLS_IF:Case.TC_LOGIC_XLS_IF_001 = XLS_IF(TRUE(),42,1/0)
# ISO/IEC 26300-2 2015 section §6.14.6 [Full] OpenFormula INDEX returns the selected fixture cell.
rule TestCube_Lookup::Function_Lookup.FN_XLS_INDEX:Case.TC_LOOKUP_XLS_INDEX_001 = XLS_INDEX(MockCube::Row.Data1:Column.C1..C3,1,2)
# ISO/IEC 26300-2 2015 section §6.12.24 [Full] OpenFormula Newton-Raphson periodic rate converges within tolerance.
rule TestCube_Financial::Function_Financial.FN_XLS_IRR:Case.TC_FIN_XLS_IRR_001 = XLS_IRR(MockCube::Row.Periodic:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.12.24 [Strict] OpenFormula alternate guess reaches the same periodic root.
rule TestCube_Financial::Function_Financial.FN_XLS_IRR:Case.TC_FIN_XLS_IRR_002 = XLS_IRR(MockCube::Row.Periodic:Column.C1..C3,0.5)
# ISO/IEC 26300-2 2015 section §6.14.9 [Full] OpenFormula exact match returns one-based position.
rule TestCube_Lookup::Function_Lookup.FN_XLS_MATCH:Case.TC_LOOKUP_XLS_MATCH_001 = XLS_MATCH(20,MockCube::Row.Data1:Column.C1..C3,0)
# ISO/IEC 26300-2 2015 section §6.18.45 [Full] OpenFormula maximum selects the greatest value.
rule TestCube_Aggregate::Function_Aggregate.FN_XLS_MAX:Case.TC_AGG_XLS_MAX_001 = XLS_MAX(-2,7,3)
# ISO/IEC 26300-2 2015 section §6.18.48 [Full] OpenFormula minimum selects the least value.
rule TestCube_Aggregate::Function_Aggregate.FN_XLS_MIN:Case.TC_AGG_XLS_MIN_001 = XLS_MIN(-2,7,3)
# ISO/IEC 26300-2 2015 section §6.10.15 [Full] Repeated OpenFormula time calls are stable within evaluation tolerance.
rule TestCube_Date::Function_Date.FN_XLS_NOW:Case.TC_DATE_XLS_NOW_001 = XLS_NOW()-XLS_NOW()
# ISO/IEC 26300-2 2015 section §6.12.30 [Full] OpenFormula DCF discounts end-of-period cash flows.
rule TestCube_Financial::Function_Financial.FN_XLS_NPV:Case.TC_FIN_XLS_NPV_001 = XLS_NPV(0.1,100,100)
# ISO/IEC 26300-2 2015 section §6.12.30 [Strict] OpenFormula rejects a singular discount rate.
rule TestCube_Financial::Function_Financial.FN_XLS_NPV:Case.TC_FIN_XLS_NPV_002 = XLS_NPV(-1,10)
# ISO/IEC 26300-2 2015 section §6.14.11 [Full] OpenFormula offset moves one column right.
rule TestCube_Lookup::Function_Lookup.FN_XLS_OFFSET:Case.TC_LOOKUP_XLS_OFFSET_001 = XLS_OFFSET(MockCube::Row.Data1:Column.C1,0,1)
# ISO/IEC 26300-2 2015 section §6.16.50 [Full] OpenFormula random value lies in the half-open unit interval.
rule TestCube_Volatile::Function_Volatile.FN_XLS_RAND:Case.TC_VOL_XLS_RAND_001 = AND(XLS_RAND()>=0,XLS_RAND()<1)
# ISO/IEC 26300-2 2015 section §6.16.51 [Full] Equal OpenFormula bounds return the bound.
rule TestCube_Volatile::Function_Volatile.FN_XLS_RANDBETWEEN:Case.TC_VOL_XLS_RANDBETWEEN_001 = XLS_RANDBETWEEN(5,5)
# ISO/IEC 26300-2 2015 section §6.20.18 [Full] OpenFormula repeats text three times.
rule TestCube_String::Function_String.FN_XLS_REPT:Case.TC_STRING_XLS_REPT_001 = XLS_REPT("ab",3)
# ISO/IEC 26300-2 2015 section §6.13.30 [Full] Returns the fixture reference row count.
rule TestCube_Lookup::Function_Lookup.FN_XLS_ROWS:Case.TC_LOOKUP_XLS_ROWS_001 = XLS_ROWS(MockCube::Row.Header..Data2:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.16.61 [Full] OpenFormula scalar sum.
rule TestCube_Aggregate::Function_Aggregate.FN_XLS_SUM:Case.TC_AGG_XLS_SUM_001 = XLS_SUM(1,2,3)
# ISO/IEC 26300-2 2015 section §6.20.23 [Full] OpenFormula fixed-decimal formatting retains two places.
rule TestCube_String::Function_String.FN_XLS_TEXT:Case.TC_STRING_XLS_TEXT_001 = XLS_TEXT(1234.5,"0.00")
# ISO/IEC 26300-2 2015 section §6.10.19 [Full] Repeated OpenFormula date calls use the same day.
rule TestCube_Date::Function_Date.FN_XLS_TODAY:Case.TC_DATE_XLS_TODAY_001 = XLS_TODAY()-XLS_TODAY()
# ISO/IEC 26300-2 2015 section §6.15.9 [Full] OpenFormula true is stored as numeric one.
rule TestCube_Logical::Function_Logical.FN_XLS_TRUE:Case.TC_LOGIC_XLS_TRUE_001 = XLS_TRUE()
# ISO/IEC 26300-2 2015 section §6.20.27 [Full] OpenFormula Unicode uppercase expansion.
rule TestCube_String::Function_String.FN_XLS_UPPER:Case.TC_STRING_XLS_UPPER_001 = XLS_UPPER("Straße")
# ISO/IEC 26300-2 2015 section §6.13.34 [Full] OpenFormula numeric text conversion.
rule TestCube_String::Function_String.FN_XLS_VALUE:Case.TC_STRING_XLS_VALUE_001 = XLS_VALUE("12.5")
# ISO/IEC 26300-2 2015 section §6.14.12 [Full] Exact vertical lookup returns the second-column value.
rule TestCube_Lookup::Function_Lookup.FN_XLS_VLOOKUP:Case.TC_LOOKUP_XLS_VLOOKUP_001 = XLS_VLOOKUP(30,MockCube::Row.Data1..Data2:Column.C1..C3,2,FALSE())
# ISO/IEC 26300-2 2015 section §6.12.51 [Full] OpenFormula Newton-Raphson uses Actual/365 day-count fractions.
rule TestCube_Financial::Function_Financial.FN_XLS_XIRR:Case.TC_FIN_XLS_XIRR_001 = XLS_XIRR(MockCube::Row.Dated:Column.C1..C3,MockCube::Row.Dates:Column.C1..C3)
# ISO/IEC 26300-2 2015 section §6.12.51 [Strict] OpenFormula alternate guess reaches the same dated root.
rule TestCube_Financial::Function_Financial.FN_XLS_XIRR:Case.TC_FIN_XLS_XIRR_002 = XLS_XIRR(MockCube::Row.Dated:Column.C1..C3,MockCube::Row.Dates:Column.C1..C3,0.5)
# ISO/IEC 26300-2 2015 section §6.10.24 [Full] OpenFormula extracts a valid century leap year.
rule TestCube_Date::Function_Date.FN_XLS_YEAR:Case.TC_DATE_XLS_YEAR_001 = XLS_YEAR(XLS_DATE(2000,2,29))

