assert TestCube_Trigonometric::@.value:Function_Trigonometric.FN_ASIN:Case.TC_TRIG_ASIN_001 <= 1.570796326794897 "Upper domain endpoint. upper bound"
# TYPED_ASSERT TestCube_Trigonometric::@.value:Function_Trigonometric.FN_ASIN:Case.TC_TRIG_ASIN_002 is ERROR #NUM! via ERROR_MATCH | Operand above one.
