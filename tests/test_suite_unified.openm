# OpenFormula 1.4 section 6.14.11 [Medium] Rejects missing parameters
rule TestCube_Lookup::Function_Lookup.FN_OFFSET:Case.Invalid_1 = OFFSET()
# OpenFormula 1.4 section 6.14.9 [Small] Finds an exact match
rule TestCube_Lookup::Function_Lookup.FN_MATCH:Case.Happy_1 = MATCH(10,MockCube::Mock_Row.R1:Mock_Col.C1,0)
# OpenFormula 1.4 section 6.14.9 [Small] Returns not-available when absent
