# ONE PASS/FAIL VALUE PER TESTED FUNCTION
rule TestCube_Aggregate::Function_Aggregate.FN_AVERAGE:Case.PassFail = AND(IFERROR(TestCube_Aggregate::Function_Aggregate.FN_AVERAGE:Case.Happy_1 == 15,FALSE()),IFERROR(TestCube_Aggregate::Function_Aggregate.FN_AVERAGE:Case.Edge_1 == 0,FALSE()),IFERROR(TestCube_Aggregate::Function_Aggregate.FN_AVERAGE:Case.Invalid_1,"__OPENM_EXPECTED_ERROR__") == "__OPENM_EXPECTED_ERROR__")
rule TestCube_Aggregate::Function_Aggregate.FN_COUNT:Case.PassFail = AND(IFERROR(TestCube_Aggregate::Function_Aggregate.FN_COUNT:Case.Happy_1 == 2,FALSE()),IFERROR(TestCube_Aggregate::Function_Aggregate.FN_COUNT:Case.Edge_1 == 0,FALSE()),IFERROR(TestCube_Aggregate::Function_Aggregate.FN_COUNT:Case.Invalid_1 == 0,FALSE()))
