# AUTOMATABLE ASSERTIONS
assert TestCube_Math::@.value:Function_Math.FN_ABS:Case.TC_MATH_ABS_001 == 0.0 "Negative zero shall be converted to positive zero."
assert TestCube_Math::@.value:Function_Math.FN_ABS:Case.TC_MATH_ABS_002 == 42.5 "Finite negative operand returns its magnitude."
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_ABS:Case.TC_MATH_ABS_003 is ERROR #DIV/0! via PROPAGATES_ERROR | Incoming division error is returned unchanged.
assert TestCube_Math::@.value:Function_Math.FN_ROUND:Case.TC_MATH_ROUND_001 == 2.68 "Binary-sensitive decimal midpoint rounds away from zero."
assert TestCube_Math::@.value:Function_Math.FN_ROUND:Case.TC_MATH_ROUND_002 == -3 "Negative midpoint rounds away from zero."
assert TestCube_Math::@.value:Function_Math.FN_ROUNDUP:Case.TC_MATH_ROUNDUP_001 == -1.24 "Negative value rounds away from zero."
assert TestCube_Math::@.value:Function_Math.FN_ROUNDDOWN:Case.TC_MATH_ROUNDDOWN_001 == -1.23 "Negative value rounds toward zero."
assert TestCube_Math::@.value:Function_Math.FN_PI:Case.TC_MATH_PI_001 >= 3.1415926535897922 "Returns binary64 pi. lower bound"
assert TestCube_Math::@.value:Function_Math.FN_PI:Case.TC_MATH_PI_001 <= 3.141592653589794 "Returns binary64 pi. upper bound"
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_PI:Case.TC_MATH_PI_002 is ERROR #EXPRESSION! via ERROR_MATCH | Rejects an argument.
assert TestCube_Math::@.value:Function_Math.FN_LN:Case.TC_MATH_LN_001 == 0 "Natural logarithm identity."
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_LN:Case.TC_MATH_LN_002 is ERROR #NUM! via ERROR_MATCH | Zero is outside the logarithm domain.
assert TestCube_Math::@.value:Function_Math.FN_LOG:Case.TC_MATH_LOG_001 >= 2.9999999989999999 "Integer logarithm in base two. lower bound"
assert TestCube_Math::@.value:Function_Math.FN_LOG:Case.TC_MATH_LOG_001 <= 3.0000000010000001 "Integer logarithm in base two. upper bound"
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_LOG:Case.TC_MATH_LOG_002 is ERROR #NUM! via ERROR_MATCH | Base one is invalid.
assert TestCube_Math::@.value:Function_Math.FN_LOG10:Case.TC_MATH_LOG10_001 >= 2.9999999989999999 "Common logarithm at a power of ten. lower bound"
assert TestCube_Math::@.value:Function_Math.FN_LOG10:Case.TC_MATH_LOG10_001 <= 3.0000000010000001 "Common logarithm at a power of ten. upper bound"
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_LOG10:Case.TC_MATH_LOG10_002 is ERROR #NUM! via ERROR_MATCH | Negative operand is outside the real domain.
assert TestCube_Math::@.value:Function_Math.FN_EXP:Case.TC_MATH_EXP_001 == 1 "Exponential identity."
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_EXP:Case.TC_MATH_EXP_002 is ERROR #NUM! via ERROR_MATCH | Binary64 overflow is a numeric error.
assert TestCube_Math::@.value:Function_Math.FN_SQRT:Case.TC_MATH_SQRT_001 == 2 "Perfect square."
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_SQRT:Case.TC_MATH_SQRT_002 is ERROR #NUM! via ERROR_MATCH | Negative operand is outside the real domain.
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_SQRT:Case.TC_MATH_SQRT_003 is ERROR #DIV/0! via PROPAGATES_ERROR | Typed incoming CellError argument is returned immediately.
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_SQRT:Case.TC_MATH_SQRT_004 is ERROR #DIV/0! via PROPAGATES_ERROR | Nested error short-circuits domain logic.
assert TestCube_Math::@.value:Function_Math.FN_POWER:Case.TC_MATH_POWER_001 == 1024 "Exact integer power."
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_POWER:Case.TC_MATH_POWER_002 is ERROR #DIV/0! via ERROR_MATCH | Zero to a negative power divides by zero.
assert TestCube_Math::@.value:Function_Math.FN_SIGN:Case.TC_MATH_SIGN_001 == -1 "Negative classification."
assert TestCube_Math::@.value:Function_Math.FN_SIGN:Case.TC_MATH_SIGN_002 == 0 "Signed zero classifies as zero."
assert TestCube_Math::@.value:Function_Math.FN_INT:Case.TC_MATH_INT_001 == -3 "OM Core truncates toward zero."
assert TestCube_Math::@.value:Function_Math.FN_MOD:Case.TC_MATH_MOD_001 == 2 "Remainder takes the positive divisor sign."
assert TestCube_Math::@.value:Function_Math.FN_MOD:Case.TC_MATH_MOD_002 == -2 "Remainder takes the negative divisor sign."
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_MOD:Case.TC_MATH_MOD_003 is ERROR #DIV/0! via ERROR_MATCH | Zero divisor.
assert TestCube_Math::@.value:Function_Math.FN_QUOTIENT:Case.TC_MATH_QUOTIENT_001 == -3 "Quotient truncates toward zero."
assert TestCube_Math::@.value:Function_Math.FN_FLOOR:Case.TC_MATH_FLOOR_001 == 6 "Round down to a significance multiple."
# TYPED_ASSERT TestCube_Math::@.value:Function_Math.FN_FLOOR:Case.TC_MATH_FLOOR_002 is ERROR #DIV/0! via ERROR_MATCH | Zero significance.
assert TestCube_Math::@.value:Function_Math.FN_CEILING:Case.TC_MATH_CEILING_001 == -6 "Round toward positive infinity."
