# OpenFormula 1.4 section 6.10.22 [Medium] Returns the week containing the first day of the year
rule TestCube_Date::Function_Date.FN_WEEKNUM:Case.Happy_1 = WEEKNUM(DATE(2024,1,1))
# OpenFormula 1.4 section 6.10.22 [Medium] Handles the year-end boundary
