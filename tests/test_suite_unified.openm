# OpenFormula 1.4 section 6.14.9 [Small] Rejects missing parameters
rule TestCube_Lookup::Function_Lookup.FN_MATCH:Case.Invalid_1 = MATCH()
# OpenFormula 1.4 section 6.14.8 [Medium] Finds a value in a reference
rule TestCube_Lookup::Function_Lookup.FN_LOOKUP:Case.Happy_1 = LOOKUP(10,MockCube::Mock_Row.R1:Mock_Col.C1)
