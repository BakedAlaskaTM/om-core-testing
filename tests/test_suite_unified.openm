# ==============================================================================
# OPENFORMULA 1.4 FUNCTION-LEVEL CONFORMANCE DASHBOARD
# Generated from tests/test-matrix.csv; formulas use OM Core comma syntax.
# Error rows retain raw errors and require typed-harness verification.
# ==============================================================================

dim Mock_Row R1 R2 R3
dim Mock_Col C1 C2 C3
cube MockCube Mock_Row Mock_Col
view MockView = MockCube rows: Mock_Row cols: Mock_Col
hval view_id=MockView row=0 col=0 value=10
hval view_id=MockView row=0 col=1 value=20
hval view_id=MockView row=0 col=2 value=50
hval view_id=MockView row=1 col=0 value=30
hval view_id=MockView row=1 col=1 value=40
hval view_id=MockView row=1 col=2 value=100
hval view_id=MockView row=2 col=0 value="Alpha"
hval view_id=MockView row=2 col=1 value="Beta"
hval view_id=MockView row=2 col=2 value="Gamma"

dim Case Edge_1 Happy_1 Invalid_1 PassFail
dim Function_Aggregate FN_AVERAGE FN_COUNT FN_COUNTA FN_COUNTIF FN_COUNTIFS FN_MAX FN_MIN FN_SUM FN_SUMIF FN_SUMIFS
cube TestCube_Aggregate Function_Aggregate Case
view TestRunner_Aggregate = TestCube_Aggregate rows: Function_Aggregate cols: Case
dim Function_Date FN_DATE FN_DAY FN_EOMONTH FN_MONTH FN_NOW FN_TODAY FN_WEEKDAY FN_WEEKNUM FN_YEAR
cube TestCube_Date Function_Date Case
view TestRunner_Date = TestCube_Date rows: Function_Date cols: Case
dim Function_Financial FN_IRR FN_NPV FN_XIRR
cube TestCube_Financial Function_Financial Case
view TestRunner_Financial = TestCube_Financial rows: Function_Financial cols: Case
dim Function_Logical FN_AND FN_FALSE FN_IF FN_IFERROR FN_NOT FN_OR FN_TRUE FN_XOR
cube TestCube_Logical Function_Logical Case
view TestRunner_Logical = TestCube_Logical rows: Function_Logical cols: Case
dim Function_Lookup FN_INDEX FN_LOOKUP FN_MATCH FN_OFFSET
cube TestCube_Lookup Function_Lookup Case
view TestRunner_Lookup = TestCube_Lookup rows: Function_Lookup cols: Case
dim Function_Math FN_ABS FN_ACOS FN_ASIN FN_ATAN FN_ATAN2 FN_CEILING FN_COS FN_DEGREES FN_EXP FN_FLOOR FN_INT FN_LN FN_LOG FN_LOG10 FN_MOD FN_PI FN_POWER FN_QUOTIENT FN_RADIANS FN_ROUND FN_ROUNDDOWN FN_ROUNDUP FN_SIGN FN_SIN FN_SQRT FN_TAN FN_TRUNC
cube TestCube_Math Function_Math Case
view TestRunner_Math = TestCube_Math rows: Function_Math cols: Case
dim Function_Metadata FN_VALUE
cube TestCube_Metadata Function_Metadata Case
view TestRunner_Metadata = TestCube_Metadata rows: Function_Metadata cols: Case
dim Function_String FN_CHAR FN_CODE FN_CONCATENATE FN_FIND FN_LEFT FN_LEN FN_LOWER FN_MID FN_PROPER FN_REPLACE FN_REPT FN_RIGHT FN_SUBSTITUTE FN_TRIM FN_UPPER
cube TestCube_String Function_String Case
view TestRunner_String = TestCube_String rows: Function_String cols: Case
dim Function_Volatile FN_RAND FN_RANDBETWEEN
cube TestCube_Volatile Function_Volatile Case
view TestRunner_Volatile = TestCube_Volatile rows: Function_Volatile cols: Case

