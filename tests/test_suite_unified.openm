# OpenFormula 1.4 section 6.10.5 [Small] Invalid or error input for DAY
rule TestCube_Date::Function_Date.FN_DAY:Case.Invalid_1 = DAY("x")
# OpenFormula 1.4 section 6.10.14 [Small] Extracts the month from a date
rule TestCube_Date::Function_Date.FN_MONTH:Case.Happy_1 = MONTH(DATE(2024,12,1))
