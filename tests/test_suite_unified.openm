# OpenFormula 1.4 section 6.10.24 [Small] Invalid or error input for YEAR
rule TestCube_Date::Function_Date.FN_YEAR:Case.Invalid_1 = YEAR("x")
# OpenFormula 1.4 section 6.10.10 [Medium] Returns the final day of the current month
rule TestCube_Date::Function_Date.FN_EOMONTH:Case.Happy_1 = DAY(EOMONTH(DATE(2024,1,1),0))
# OpenFormula 1.4 section 6.10.10 [Medium] Moves to the end of the following month
